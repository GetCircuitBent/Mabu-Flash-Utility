# Build / tooling artifacts
*.log
*.tmp

# Built GUI executable (regenerate with app/build/build-exe.ps1)
app/MabuFlash.exe

# Runtime flash logs
log/

# OS cruft
Thumbs.db
desktop.ini
.DS_Store

# Scratch / working dumps -- never commit these
firmware/scratch/

# Tool downloads fetched and hash-verified at runtime by scripts\install-tools.ps1
# and scripts\install-android-driver.ps1. Re-downloadable, so never commit them.
tools/zadig.exe
tools/platform-tools.zip
tools/platform-tools/
tools/google-usb-driver-source.zip
tools/google-usb-driver/

# Release build output (app\build\make-payload.ps1, app\bootstrap\build-bootstrap.ps1)
/dist/

# Local scratch: git worktrees and agent state, never repo content
/.claude/
