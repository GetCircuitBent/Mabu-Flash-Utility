# Gradle / Android build output
.gradle/
build/
app/build/
.cxx/

# Points at YOUR Android SDK; machine-specific, never committed.
local.properties

# IDE
.idea/
*.iml

# Release signing. NEVER commit either of these: the keystore is the identity
# every published sample APK is signed with, and losing or leaking it means
# every installed copy has to be uninstalled before it can be updated again.
keystore.properties
*.jks
*.keystore
