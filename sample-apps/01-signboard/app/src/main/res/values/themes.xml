<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      No action bar: the admin page is the whole screen, and show mode goes
      fully immersive. Inheriting from the platform theme (not AppCompat)
      keeps the dependency surface small; the Activity is a plain
      android.app.Activity.
    -->
    <style name="Theme.Signboard" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/gcb_bluewood_900</item>
        <item name="android:colorAccent">@color/gcb_la_palma</item>
    </style>
</resources>
