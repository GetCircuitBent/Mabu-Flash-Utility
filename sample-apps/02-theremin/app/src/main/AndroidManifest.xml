<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Reads .wav files from /sdcard/theremin/. The bundled sample needs no
         permission, so the app still plays if you never grant this. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- ===================================================================
         THE SAMPLE RECORDER IS OPT-IN. Uncomment the line below, rebuild,
         reinstall, then:
           adb shell pm grant com.getcircuitbent.mabu.theremin \
             android.permission.RECORD_AUDIO

         Same two-step shape as autostart in Sample App 1, and for the same
         reason: switching on a microphone is a decision somebody should make
         deliberately rather than inherit from a sample app they installed to
         look at. SampleRecorder.kt explains what it does.
         =================================================================== -->
    <!-- <uses-permission android:name="android.permission.RECORD_AUDIO" /> -->

    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Theremin">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ControlReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.getcircuitbent.mabu.theremin.ARM" />
                <action android:name="com.getcircuitbent.mabu.theremin.MAP" />
                <action android:name="com.getcircuitbent.mabu.theremin.TRACKER" />
                <action android:name="com.getcircuitbent.mabu.theremin.SAMPLE" />
                <action android:name="com.getcircuitbent.mabu.theremin.GESTURE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
